GEMINI_API_KEY=
ALPHA_VANTAGE_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
# New projects: publishable key (sb_publishable_...). Legacy: anon JWT.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NESTOR_DEMO_USER_ID=

# Local demo mode: bypasses Supabase reads/writes for F5/F6 testing.
# Set to "true" only for local development.
NEXT_PUBLIC_NESTOR_MOCK_DATA=false

# Marketstack API for EOD data and trending stocks
MARKETSTACK_API_KEY=

# FRED (Federal Reserve Economic Data) API — macroeconomic indicators
# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ML: omit or set `inline` so Next.js runs Python via ml/bridge.py (no uvicorn).
# Or set a full URL to use a separate FastAPI server, e.g. http://127.0.0.1:8000
ML_API_URL=inline
